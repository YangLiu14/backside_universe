{
  "name": "backside-photo-universe",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs && node scripts/check-transition.mjs",
    "check:hi3d-galleries": "node scripts/check-hi3d-galleries.cjs",
    "check:canine-museum": "node scripts/check-canine-museum.cjs",
