    "check:story-tour": "node scripts/check-story-tour.cjs",
    "check:island-rooms": "node scripts/check-island-rooms.cjs",
    "check:island-passages": "node scripts/check-island-passages.cjs",
    "check:island-walk": "node scripts/check-island-walk.cjs",
    "check:island-stories": "node scripts/check-island-stories.cjs",
    "check:cup-harbor": "node scripts/check-cup-harbor.cjs",
    "check:desk-weather": "node scripts/check-desk-weather.cjs",
    "check:desk-ocean": "node scripts/check-desk-ocean.cjs",
    "check:desk-explore": "node scripts/check-desk-explore.cjs",
    "check:desktop-islands": "node scripts/check-desktop-islands.cjs",
    "check:desktop-bookroom": "node --test scripts/check-desktop-bookroom.mjs",
    "check:bookroom-loop": "node --test scripts/check-bookroom-loop.mjs",
    "check:language": "node scripts/check-language.cjs"
  }
}
