# Copy to .env.local. Local credentials are never served from dist/.
WORLD_LABS_API_KEY=

# International personal account; verify the website email against mcp-account before pinning.
HI3D_ACCOUNT_EMAIL=
HI3D_MCP_USER_SHA256=
# Optional Open Platform credentials, only for --via api.
HI3D_CLIENT_ID=
HI3D_CLIENT_SECRET=
# Optional per-project credit ceiling. Empty uses existing credits; 0 allows reuse only.
UNIVERSE_HI3D_BUDGET=
