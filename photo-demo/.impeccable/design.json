  "narrative": {
    "northStar": "照片的另一面",
    "overview": "沿用用户选定的白桌、蓝杯照片和既有视觉方向：日常空间是画面的依据，微缩假期从同一个物件里显现。保留原图的白色、钴蓝和暖灯质感；说明文字安静、短促，界面只帮助人靠近、旋转和返回。\n\n这里记录 `photo-demo/dist` 已实现的视觉语言，合并原有方向，并非新的风格提案或另一次风格共识。照片构图、首屏位置、连续镜头及资产状态属于这个样片，详见 `photo-demo/.impeccable/surface.md`；它们不自动成为未来所有页面的模板。",
    "keyCharacteristics": [
      "原照片提供可信的材质和色彩依据。",
      "炭黑底、暖白文字，让作品成为视觉主体。",
      "宋体标题配无衬线控件，文字保持轻而清晰。",
      "通过连续镜头和真实几何表达深度，UI 控件保持简洁。"
    ],
    "rules": [
      {
        "name": "The Photo Authority Rule",
        "body": "原照片的颜色与构图具有优先权；补建材质围绕它衔接，不用统一滤镜改写照片本身。",
        "section": "colors"
      },
      {
        "name": "The Continuous Space Rule",
        "body": "靠近、旋转和返回都由同一场景、同一渲染摄影机及连续状态计算，不能把入口和背面做成两张互不相干的画面切换。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 保留用户照片的完整构图、白桌、钴蓝杯与暖灯质感。",
      "**Do** 让文字和控制围绕影像退到边缘，保留明确的焦点、返回和暂停操作。",
      "**Do** 将旋转、缩放、文字揭示、投影淡出和景深关联到同一连续状态。",
      "**Do** 按实际加载资产给出来源，并将补建空间与照片记录的事实区分。"
    ],
    "donts": [
      "**Don't** 把当前暖白主按钮记成未实现的蓝色按钮。",
      "**Don't** 用切换场景或裁切原图替代照片到蓝杯的连续路径。",
      "**Don't** 把照片投影和人工补建描述成已经实现单张照片自动全视角重建。",
      "**Don't** 把当前手工景观与 Hi3D 小屋组合描述成已经完成的新 Hi3D 整座景观。"
    ]
  }
}
