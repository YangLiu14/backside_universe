# Shared rules for the outer repository, including photo-demo/.
# Dependencies and local environments
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.cache/
.tripo/

# Local evidence, logs, editor/OS files, and credentials
evidence/
.impeccable/review/
.DS_Store
*.log
*.tmp
*.part
.env
.env.*
!.env.example
*.pem
*.key

# Source photos, textures, screenshots, and media stay on the local machine.
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[wW][eE][bB][pP]
*.[gG][iI][fF]
# The README's compact, public demonstration is the sole tracked media asset.
!/docs/media/desk-to-islands.gif
*.[sS][vV][gG]
*.[bB][mM][pP]
*.[iI][cC][oO]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.avif
*.heic
*.heif
*.exr
*.hdr
*.mp4
*.mov
*.webm
*.mp3
*.m4a
*.wav
*.ogg

# 3D scenes, generated meshes, Gaussian data, and ML checkpoints
*.glb
*.gltf
*.obj
*.fbx
*.blend
*.stl
*.ply
*.splat
*.ksplat
*.spz
*.rad
*.usd
*.usda
*.usdc
*.usdz
*.bin
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5

# Downloaded archives and packaged environments
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.whl
*.dmg


# Offline Git history backups must never enter the source repository.
*.bundle
.git-backups/
git-backups/
